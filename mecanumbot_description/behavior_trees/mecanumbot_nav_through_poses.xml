<!--
  navigate_through_poses counterpart of mecanumbot_nav_to_pose.xml. Same
  rationale: 2 Hz replanning, no Spin, short Wait/BackUp, and costmap
  recoveries that preserve the near field instead of erasing the obstacle
  that caused the failure.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="2" name="ComputePathThroughPoses">
            <ReactiveSequence name="ComputePathThroughPoses">
              <!--
                The frames are not optional here. RemovePassedGoals takes them
                as BT ports defaulting to "map" and "base_link", and does not
                read bt_navigator's robot_base_frame parameter the way Spin and
                BackUp do. This robot's frame is mecanumbot/base_link, so on the
                default the lookup from map fails, the node returns FAILURE, and
                the ReactiveSequence never reaches ComputePathThroughPoses at
                all: navigate_through_poses burns its recoveries without ever
                planning once. navigate_to_pose has no such node, which is why
                only the route goals were affected.
              -->
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.6"
                                 global_frame="map" robot_base_frame="mecanumbot/base_link"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </ReactiveSequence>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context"
                                      service_name="global_costmap/clear_except_global_costmap"
                                      reset_distance="2.0"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="2" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearCostmapExceptRegion name="ClearLocalCostmap-Context"
                                    service_name="local_costmap/clear_except_local_costmap"
                                    reset_distance="1.0"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapExceptRegion name="ClearLocalCostmap-Subtree"
                                      service_name="local_costmap/clear_except_local_costmap"
                                      reset_distance="0.8"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Subtree"
                                      service_name="global_costmap/clear_except_global_costmap"
                                      reset_distance="2.0"/>
          </Sequence>
          <Wait wait_duration="1"/>
          <BackUp backup_dist="0.20" backup_speed="0.10"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
