<?xml version="1.0" ?>
<!--
  Scenario actor: a standing person, dimensioned from the `sim_human_*` bodies in
  the MJCF. Only the legs matter to the 2D lidar, which sits about 0.13 m above
  the floor and slices them at 0.05...0.55 m - that leg return is what DR-SPAAM is
  trained to pick up, so leg radius and separation are the numbers that must match
  between the two backends.

  On MuJoCo the figure is seven mocap bodies and an exercise gait articulates its
  two spine segments and four limbs. Here it is a single rigid link, so the parts
  below are frozen in the neutral stance: `gait` is a MuJoCo-only feature, and
  this model exists so the two backends agree at rest.

  Motion is applied by VelocityControl from `gz_io_node`, which also overrides the
  angular velocity every step, so the actor cannot be tipped over or shoved by the
  robot.
-->
<sdf version="1.9">
  <model name="sim_human">
    <link name="body">
      <inertial>
        <mass>70.0</mass>
        <pose>0 0 0.8 0 0 0</pose>
        <inertia><ixx>10.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>10.0</iyy><iyz>0</iyz><izz>2.0</izz></inertia>
      </inertial>

      <!-- Lower spine segment: hip 0.45 -> chest 0.85. -->
      <collision name="torso_lower_collision">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.40</length></cylinder></geometry>
      </collision>
      <visual name="torso_lower_visual">
        <pose>0 0 0.65 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.40</length></cylinder></geometry>
        <material><ambient>1.0 0.42 0.04 1</ambient><diffuse>1.0 0.42 0.04 1</diffuse></material>
      </visual>

      <!-- Upper spine segment: chest 0.85 -> crown 1.15. -->
      <collision name="torso_upper_collision">
        <pose>0 0 1.00 0 0 0</pose>
        <geometry><cylinder><radius>0.145</radius><length>0.30</length></cylinder></geometry>
      </collision>
      <visual name="torso_upper_visual">
        <pose>0 0 1.00 0 0 0</pose>
        <geometry><cylinder><radius>0.145</radius><length>0.30</length></cylinder></geometry>
        <material><ambient>1.0 0.42 0.04 1</ambient><diffuse>1.0 0.42 0.04 1</diffuse></material>
      </visual>

      <visual name="head_visual">
        <pose>0 0 1.23 0 0 0</pose>
        <geometry><sphere><radius>0.085</radius></sphere></geometry>
        <material><ambient>0.90 0.72 0.58 1</ambient><diffuse>0.90 0.72 0.58 1</diffuse></material>
      </visual>

      <!-- Arms: shoulders at 1.09, hanging 0.42 m to 0.67. -->
      <collision name="arm_left_collision">
        <pose>0 0.17 0.88 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="arm_left_visual">
        <pose>0 0.17 0.88 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.95 0.55 0.15 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material>
      </visual>

      <collision name="arm_right_collision">
        <pose>0 -0.17 0.88 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="arm_right_visual">
        <pose>0 -0.17 0.88 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.95 0.55 0.15 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material>
      </visual>

      <!-- Legs: hips at 0.55, hanging 0.50 m to 0.05. The lidar slice. -->
      <collision name="leg_left_collision">
        <pose>0 0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
      </collision>
      <visual name="leg_left_visual">
        <pose>0 0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>

      <collision name="leg_right_collision">
        <pose>0 -0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
      </collision>
      <visual name="leg_right_visual">
        <pose>0 -0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>
    </link>

    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
