<?xml version="1.0" ?>
<!--
  Scenario actor: a standing person, dimensioned from the MuJoCo `sim_human_*`
  bodies. Only the legs matter to the 2D lidar, which sits about 0.13 m above the
  floor and slices them at 0.05...0.55 m - that leg return is what DR-SPAAM is
  trained to pick up, so leg radius and separation are the numbers that must match
  between the two backends.

  Motion is applied by VelocityControl from `gz_io_node`, which also overrides the
  angular velocity every step, so the actor cannot be tipped over or shoved by the
  robot.
-->
<sdf version="1.9">
  <model name="sim_human">
    <link name="body">
      <inertial>
        <mass>70.0</mass>
        <pose>0 0 0.8 0 0 0</pose>
        <inertia><ixx>10.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>10.0</iyy><iyz>0</iyz><izz>2.0</izz></inertia>
      </inertial>

      <collision name="torso_collision">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.70</length></cylinder></geometry>
      </collision>
      <visual name="torso_visual">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.16</radius><length>0.70</length></cylinder></geometry>
        <material><ambient>1.0 0.42 0.04 1</ambient><diffuse>1.0 0.42 0.04 1</diffuse></material>
      </visual>

      <collision name="leg_left_collision">
        <pose>0 0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
      </collision>
      <visual name="leg_left_visual">
        <pose>0 0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>

      <collision name="leg_right_collision">
        <pose>0 -0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
      </collision>
      <visual name="leg_right_visual">
        <pose>0 -0.11 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material>
      </visual>
    </link>

    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
