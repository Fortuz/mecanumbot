<?xml version="1.0" ?>
<!--
  Scenario prop: a movable cube ("brick"), the Gazebo twin of the `sim_cube_*`
  free bodies in the MJCF. Unlike the mats and the actors this one is fully
  dynamic - the robot pushes it by driving into it, which is the point.

  Edge and mass match the MJCF defaults (0.07 m, 0.15 kg) so a scenario reads the
  same on both backends; a scenario's `size`/`mass` override only takes effect on
  MuJoCo. The 0.07 m edge is what makes it grippable: the grabber shafts sit about
  0.034 m up with a 0.116 m clear gap between them, so the cube reaches into that
  band and still leaves 23 mm a side to close on.

  It also sits under the 0.13 m lidar plane and never appears in `scan`, exactly as
  a real brick would not, so `/sim/props` is the only place its position can be
  read. The PosePublisher below is what feeds that topic.
-->
<sdf version="1.9">
  <model name="sim_cube">
    <link name="body">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0001225</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001225</iyy><iyz>0</iyz>
          <izz>0.0001225</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
        <material><ambient>0.72 0.30 0.20 1</ambient><diffuse>0.72 0.30 0.20 1</diffuse></material>
      </visual>
    </link>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </model>
</sdf>
